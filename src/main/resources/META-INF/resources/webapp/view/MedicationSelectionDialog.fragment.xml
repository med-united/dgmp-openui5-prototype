<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog title="Select Medication from History (eML)" contentWidth="600px" id="medicationSelectionDialog">
        <content>
            <Table id="selectionTable" 
                   items="{app>/medicationList/entries}" 
                   mode="SingleSelectMaster" 
                   selectionChange=".onMedicationSelectionChange"
                   noDataText="No history available. Use 'New Medication' to add manually.">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Available Medications"/>
                        <ToolbarSpacer/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="Medication"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Dosage"/></Column>
                    <Column hAlign="End"><Text text="Date"/></Column>
                </columns>
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <VBox>
                                <Text text="{app>medicationName}" class="sapUiTinyMarginBottom"/>
                                <Text text="{app>pzn}" class="sapUiTinyText"/>
                            </VBox>
                            <Text text="{= ${app>dosageText} || ${app>dosageStructured} || '' }"/>
                            <Text text="{path: 'app>authoredDate', formatter: '.formatter.formatDate'}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <buttons>
             <Button text="New Medication (Manual)" icon="sap-icon://add" press=".onManualEntry" />
             <Button text="Cancel" press=".onSelectionCancel" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
