<mvc:View
    controllerName="epa.controller.MedicationPlan"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <VBox class="sapUiSmallMargin">
        <!-- eMP Toolbar -->
        <OverflowToolbar>
            <Title text="Current Medication Plan" level="H3"/>
            <ToolbarSpacer/>
            <Button text="Add Medication" icon="sap-icon://add" type="Emphasized" press=".onAddMedication"/>
            <Button text="Export PDF" icon="sap-icon://pdf-attachment" press=".onExportPDF"/>
            <Button text="AMTS Check" icon="sap-icon://stethoscope" press=".onAMTSCheck"/>
        </OverflowToolbar>
        
        <!-- eMP Table — items bound to 'ui' model (plain derived array) -->
        <Table
            id="empTable"
            items="{
                path: 'ui>/medicationPlan/entries',
                sorter: {
                    path: 'status',
                    descending: false,
                    group: true
                }
            }"
            noDataText="No active medications in plan">
            
            <columns>
                <Column width="4rem"><Text text="Status"/></Column>
                <Column><Text text="Medication"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Dosage"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="PZN / ATC"/></Column>
                <Column width="15%" hAlign="End"><Text text="Actions"/></Column>
            </columns>
            
            <items>
                <ColumnListItem>
                    <cells>
                        <!-- Status Icon — FHIR R4 statuses: active, on-hold, stopped, completed, cancelled, entered-in-error, draft, unknown -->
                        <core:Icon
                            src="{= ${ui>status} === 'active' ? 'sap-icon://sys-enter-2' : (${ui>status} === 'on-hold' ? 'sap-icon://pause' : 'sap-icon://future') }"
                            color="{= ${ui>status} === 'active' ? '#107E3E' : (${ui>status} === 'on-hold' ? '#E69A17' : '#0070F2') }"
                            tooltip="{path: 'ui>status', formatter: '.formatter.formatStatus'}"/>
                            
                        <!-- Medication Info -->
                        <VBox>
                            <HBox alignItems="Center">
                                <Text text="{ui>medicationName}" class="sapUiTinyMarginBottom sapUiTinyMarginEnd sapMTextBold" wrapping="false"/>
                            </HBox>
                            <Text text="PZN: {ui>pzn}" class="sapUiTinyText"/>
                        </VBox>
                        
                        <!-- Dosage -->
                        <Text text="{= ${ui>dosageText} || ${ui>dosageStructured} }"/>
                        
                        <!-- PZN / ATC -->
                        <VBox>
                            <Text text="{ui>pzn}" class="sapUiTinyText"/>
                            <Text text="{ui>atcCode}" class="sapUiTinyText"/>
                        </VBox>
                        
                        <!-- Actions -->
                        <HBox justifyContent="End">
                            <Button icon="sap-icon://edit" type="Transparent" tooltip="Edit" press=".onEditMedication"/>
                            <Button 
                                icon="{= ${ui>status} === 'active' ? 'sap-icon://pause' : 'sap-icon://play' }" 
                                type="Transparent"
                                tooltip="{= ${ui>status} === 'active' ? 'Pause' : 'Reactivate' }"
                                press=".onPauseMedication"/>
                            <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete" press=".onDeleteMedication"/>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</mvc:View>
