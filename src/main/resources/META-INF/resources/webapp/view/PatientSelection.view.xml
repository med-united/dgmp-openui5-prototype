<mvc:View controllerName="epa.controller.PatientSelection" 
          xmlns:mvc="sap.ui.core.mvc" 
          xmlns="sap.m" 
          xmlns:l="sap.ui.layout"
          xmlns:core="sap.ui.core">
    <App>
        <pages>
            <Page title="ePA Medication Service">
                <content>
                    <l:VerticalLayout class="sapUiContentPadding">
                        
                        <!-- Search Section -->
                        <VBox class="sapUiMediumMarginBottom">
                            <Title text="Patient Search" level="H2" />
                            
                            <HBox class="sapUiSmallMarginTop" alignItems="Center">
                                <SearchField
                                    id="kvnrSearchField"
                                    placeholder="KVNR eingeben (z.B. X123456789)"
                                    width="400px"
                                    search=".onSearch"
                                    class="sapUiSmallMarginEnd" />
                            </HBox>
                        </VBox>
                        
                        <!-- Recent Patients Section -->
                        <VBox>
                            <Title text="Recent Patients" level="H2" />
                            
                            <List
                                id="recentPatientsList"
                                items="{ui>/recentPatients}"
                                mode="SingleSelectMaster"
                                selectionChange=".onRecentPatientSelect"
                                noDataText="No recent patients searched yet.">
                                
                                <StandardListItem
                                    title="{ui>firstName} {ui>lastName}"
                                    description="KVNR: {ui>kvnr}"
                                    info="{ui>birthDate}"
                                    type="Navigation" />
                            </List>
                        </VBox>
                        
                        <!-- Patient Data Tabs (visible when patient selected) -->
                        <IconTabBar
                            id="patientDataTabs"
                            visible="{ui>/patientSelected}"
                            class="sapUiMediumMarginTop"
                            expandable="false">
                            <items>
                                <!-- Tab 1: Electronic Medication Plan (eMP) -->
                                <IconTabFilter
                                    text="Current Plan"
                                    icon="sap-icon://clinical-order">
                                    <mvc:XMLView viewName="epa.view.MedicationPlan" />
                                </IconTabFilter>

                                <!-- Tab 2: Electronic Medication List (eML) -->
                                <IconTabFilter
                                    text="eML (History)"
                                    icon="sap-icon://history">
                                    <mvc:XMLView viewName="epa.view.MedicationList" />
                                </IconTabFilter>

                                <!-- Tab 3: Reconciliation -->
                                <IconTabFilter
                                    text="Reconciliation"
                                    icon="sap-icon://compare"
                                    tooltip="Reconciliation (eML vs eMP)">
                                    <mvc:XMLView viewName="epa.view.Reconciliation" />
                                </IconTabFilter>
                            </items>
                        </IconTabBar>
                        
                    </l:VerticalLayout>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
