<mvc:View
    controllerName="epa.controller.Reconciliation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">

    <VBox class="sapUiSmallMargin">
        <OverflowToolbar>
            <Title text="Reconciliation (eML vs eMP)" level="H3"/>
            <ToolbarSpacer/>
            <ComboBox selectionChange=".onTimeFilterChange" selectedKey="3_MONTHS" width="150px">
                <items>
                    <core:Item key="3_MONTHS" text="Last 3 Months" />
                    <core:Item key="6_MONTHS" text="Last 6 Months" />
                    <core:Item key="1_YEAR" text="Last Year" />
                </items>
            </ComboBox>
            <CheckBox text="Show Linked" select=".onShowLinkedToggle" selected="false" />
            <Button text="Refresh" icon="sap-icon://refresh" press="._loadReconciliation"/>
        </OverflowToolbar>
        
        <!-- Split View: eML left | eMP right -->
        <HBox class="reconciliationSplitView">
            <!-- Left Panel: eML entries -->
            <VBox width="48%" class="reconciliationPanel">
                <Toolbar>
                    <Title text="eML (Dispensements)" level="H4"/>
                </Toolbar>
                
                <table:Table
                    id="reconciliationTree"
                    rows="{path: 'ui>/reconciliation/items'}"
                    selectionMode="None"
                    enableColumnReordering="false"
                    visibleRowCount="10"
                    rowHeight="50">
                    
                    <table:rowSettingsTemplate>
                        <table:RowSettings highlight="{path: 'ui>status', formatter: '.formatRowHighlight'}" />
                    </table:rowSettingsTemplate>

                    <table:columns>
                        <!-- Medication & Status -->
                        <table:Column label="Medication" width="50%">
                            <table:template>
                                <VBox>
                                    <HBox alignItems="Center">
                                        <core:Icon 
                                            src="sap-icon://product"
                                            class="sapUiTinyMarginEnd"
                                            color="#107E3E"/>
                                        <Label text="{ui>medicationName}" design="Bold"/>
                                        <!-- Substitution indicator -->
                                        <core:Icon src="sap-icon://compare-2" color="#E69A17" visible="{= ${ui>wasSubstituted} === true }" class="sapUiTinyMarginBegin" tooltip="Substituted"/>
                                    </HBox>
                                    
                                    <HBox class="sapUiTinyMarginTop">
                                        <Label text="PZN:" class="sapUiTinyMarginEnd sapUiTinyText"/>
                                        <Text text="{ui>pzn}" class="sapUiTinyText sapUiTinyMarginEnd"/>
                                        <Label text="ATC:" class="sapUiTinyMarginEnd sapUiTinyText"/>
                                        <Text text="{ui>atcCode}" class="sapUiTinyText"/>
                                    </HBox>
                                    
                                    <VBox class="sapUiTinyMarginTop">
                                        <ObjectStatus
                                            text="{= ${ui>status} === 'LINKED' ? 'Linked' : (${ui>status} === 'PROPOSAL_MATCH' ? 'Match found' : (${ui>status} === 'UNLINKED_UPDATE' ? 'Update available' : 'Not in Plan')) }"
                                            state="{= ${ui>status} === 'LINKED' ? 'Success' : (${ui>status} === 'PROPOSAL_MATCH' ? 'Information' : (${ui>status} === 'UNLINKED_UPDATE' ? 'Warning' : 'Error')) }"
                                            icon="{= ${ui>status} === 'LINKED' ? 'sap-icon://chain-link' : (${ui>status} === 'PROPOSAL_MATCH' ? 'sap-icon://lightbulb' : (${ui>status} === 'UNLINKED_UPDATE' ? 'sap-icon://alert' : 'sap-icon://warning')) }"/>
                                        <Text text="{ui>matchReason}" class="sapUiTinyText"/>
                                    </VBox>
                                </VBox>
                            </table:template>
                        </table:Column>

                        <!-- Details -->
                        <table:Column label="Details" width="25%">
                            <table:template>
                                <VBox>
                                    <Text text="{path: 'ui>dispensedDate', formatter: '.formatter.formatDate'}"/>
                                    <Text text="{ui>dosage}" class="sapUiTinyText"/>
                                </VBox>
                            </table:template>
                        </table:Column>

                        <!-- Actions -->
                        <table:Column label="Actions" width="25%" hAlign="End">
                            <table:template>
                                <HBox justifyContent="End">
                                    <!-- Link (PROPOSAL_MATCH or ORPHAN_NEW) -->
                                    <Button
                                        text="Link"
                                        icon="sap-icon://chain-link"
                                        type="Emphasized"
                                        visible="{= ${ui>status} === 'PROPOSAL_MATCH' || ${ui>status} === 'ORPHAN_NEW' }"
                                        press=".onLinkFromTree"
                                        class="sapUiTinyMarginEnd"/>
                                        
                                    <!-- Unlink (LINKED) -->
                                    <Button
                                        icon="sap-icon://broken-link"
                                        type="Transparent"
                                        tooltip="Unlink"
                                        visible="{= ${ui>status} === 'LINKED' }"
                                        press=".onUnlinkFromTree"/>

                                    <!-- Mark as Error -->
                                    <Button
                                        icon="sap-icon://hide"
                                        type="Transparent"
                                        tooltip="Mark as Error (Hide)"
                                        press=".onMarkAsError"/>
                                </HBox>
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </VBox>
            
            <!-- Divider -->
            <core:HTML content="&lt;div style='width:4%; display:flex; align-items:center; justify-content:center; background:#f7f7f7;'&gt;&lt;span style='font-size:2em;'&gt;⟷&lt;/span&gt;&lt;/div&gt;"/>
            
            <!-- Right Panel: eMP entries -->
            <VBox width="48%" class="reconciliationPanel">
                <Toolbar>
                    <Title text="eMP (Current Plan)" level="H4"/>
                </Toolbar>
                
                <List
                    items="{path: 'ui>/reconciliation/empEntries'}"
                    noDataText="No current medication plan">
                    <StandardListItem
                        title="{ui>medicationName}"
                        description="{path: 'ui>status', formatter: '.formatter.formatStatus'}"
                        icon="sap-icon://pill"
                        info="PZN: {ui>pzn}"/>
                </List>
            </VBox>
        </HBox>
    </VBox>
</mvc:View>
