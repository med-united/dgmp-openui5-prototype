<mvc:View
    controllerName="epa.controller.MedicationList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">

    <VBox class="sapUiSmallMargin">
        <Title text="Electronic Medication List (eML)" level="H3" class="sapUiMediumMarginBottom"/>
        
        <Text 
            text="Historical dispensements linked to prescriptions, ordered by date (newest first)" 
            class="sapUiSmallMarginBottom"/>
        
        <!-- eML Table — flat list of MedicationDispense derived entries from ui model -->
        <table:Table
            id="medicationListTree"
            rows="{path: 'ui>/medicationList/entries'}"
            selectionMode="Single"
            enableColumnReordering="false"
            visibleRowCount="10"
            rowHeight="50"
            rowSelectionChange=".onMedicationRowSelect"
            noData="No medications found in eML">
            
            <table:columns>
                <!-- Medication Name & Substitution -->
                <table:Column label="Medication" width="35%">
                    <table:template>
                        <HBox alignItems="Center">
                            <core:Icon 
                                src="sap-icon://product"
                                color="#107E3E"
                                size="1.2rem"
                                class="sapUiTinyMarginEnd"/>
                            <VBox>
                                <Label text="{ui>medicationName}" design="Bold"/>
                                <!-- Substitution indicator — Must Support per ePA IG -->
                                <HBox alignItems="Center" visible="{= ${ui>wasSubstituted} === true }">
                                    <core:Icon src="sap-icon://compare-2" color="#E69A17" size="0.8rem" class="sapUiTinyMarginEnd"/>
                                    <Text text="Substituted" class="sapUiTinyText"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </table:template>
                </table:Column>

                <!-- PZN / ATC -->
                <table:Column label="PZN / ATC" width="20%">
                    <table:template>
                        <VBox>
                            <Text text="{ui>pzn}"/>
                            <Text text="{ui>atcCode}" class="sapUiTinyText"/>
                        </VBox>
                    </table:template>
                </table:Column>

                <!-- Dosage -->
                <table:Column label="Dosage" width="20%">
                    <table:template>
                        <Text text="{ui>dosageText}"/>
                    </table:template>
                </table:Column>

                <!-- Date -->
                <table:Column label="Dispensed" width="15%">
                    <table:template>
                        <Text text="{path: 'ui>dispensedDate', formatter: '.formatter.formatDate'}"/>
                    </table:template>
                </table:Column>

                <!-- Link/Unlink Status -->
                <table:Column label="Status" width="10%" hAlign="End">
                    <table:template>
                        <HBox justifyContent="End" alignItems="Center">
                             <ObjectStatus
                                text="Linked"
                                state="Success"
                                icon="sap-icon://chain-link"
                                visible="{= !!${ui>medicationStatementId} }"
                                class="sapUiTinyMarginEnd"/>
                                
                                <Button
                                icon="{= !!${ui>medicationStatementId} ? 'sap-icon://broken-link' : 'sap-icon://chain-link' }"
                                type="Transparent"
                                tooltip="{= !!${ui>medicationStatementId} ? 'Unlink from Plan' : 'Link to Plan' }"
                                press=".onLinkPress"/>
                        </HBox>
                    </table:template>
                </table:Column>

            </table:columns>
        </table:Table>
    </VBox>
</mvc:View>
